{
  "name": "@illustrata/client-sdk",
  "version": "0.1.1",
  "description": "Build, preview, check and publish client UI releases for the Illustrata platform.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Illustration-innovators/client-sdk.git"
  },
  "homepage": "https://github.com/Illustration-innovators/client-sdk#readme",
  "engines": {
    "node": ">=22.14"
  },
  "bin": {
    "illustrata-release": "bin/illustrata-release.mjs",
    "illustrata-check": "bin/illustrata-check.mjs",
    "illustrata-sdk": "bin/illustrata-sdk.mjs"
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./products": {
      "types": "./dist/products/index.d.ts",
      "import": "./dist/products/index.js"
    },
    "./preview": {
      "types": "./dist/preview/index.d.ts",
      "import": "./dist/preview/index.js"
    },
    "./preview/bridge": {
      "types": "./dist/preview/bridge.d.ts",
      "import": "./dist/preview/bridge.js"
    },
    "./postcss": {
      "types": "./dist/postcss/shadow-property-fallback.d.ts",
      "import": "./dist/postcss/shadow-property-fallback.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "dist",
    "src/runtime",
    "src/contract",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "ci": "npm run check-types && npm test",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "jsdom": "^26.1.0"
  },
  "peerDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@tailwindcss/vite": "^4.1.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "postcss": "^8.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
